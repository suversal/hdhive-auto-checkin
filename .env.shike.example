# 复制为 .env 后由 docker compose 读取。不要提交实际 .env。
# 发布后默认拉取稳定镜像；也可以固定为 :0.1.0 等已发布版本。
SHIKE_IMAGE=ghcr.io/suversal/hdhive-auto-checkin:latest
SHIKE_BIND_ADDRESS=127.0.0.1
SHIKE_PORT=8787

# 可选：自带 HTTPS。填写已指向服务器的域名后，shike.sh 自动启用 Caddy。
# 需要开放 80/443；已有反向代理时留空，改用下面的 SHIKE_PUBLIC_URL。
SHIKE_DOMAIN=

# 使用反向代理时填写外部完整来源，例如 https://shike.example.com。
# 默认在域名根路径提供服务，暂不支持子路径部署。
SHIKE_PUBLIC_URL=
SHIKE_COOKIE_SECURE=0

# 可选。留空时在数据卷自动生成并保存，升级时必须保留原值或原文件。
SHIKE_SECRET_KEY=
