FROM --platform=$BUILDPLATFORM node:22-bookworm-slim AS frontend
WORKDIR /build/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build \
    && mkdir /site \
    && cp index.html styles.css app.js calendar.css THIRD_PARTY_NOTICES.txt /site/

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SHIKE_DATA_DIR=/data

WORKDIR /app
COPY server/requirements.txt /app/server/requirements.txt
RUN pip install --no-cache-dir -r server/requirements.txt \
    && useradd --create-home --uid 10001 shike \
    && mkdir -p /data \
    && chown shike:shike /data

COPY shike /app/shike
COPY --from=frontend /site/ /app/web/
USER shike
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "from urllib.request import urlopen; urlopen('http://127.0.0.1:8787/api/health', timeout=3)" || exit 1
CMD ["python", "-m", "shike", "serve", "--host", "0.0.0.0", "--port", "8787"]
